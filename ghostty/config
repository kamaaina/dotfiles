background = 000000
font-family = Droid Sans Mono
font-size = 13
window-decoration = false
gtk-tabs-location = hidden
cursor-style = block
cursor-style-blink = false
background-opacity = 0.65
background-blur-radius = 15
shell-integration-features = no-title,no-cursor

#theme = catppuccin-frappe

command = /usr/bin/fish --login --interactive

# splits
#keybind = ctrl+b>h=new_split:right
#keybind = ctrl+b>v=new_split:down
#keybind = ctrl+a>z=toggle_split_zoom


#keybind = ctrl+m>m=toggle_mouse_reporting

# Forces auto-copied selections to sync with both clipboards
copy-on-select = clipboard

# Allow internal terminal applications to write to your system clipboard
clipboard-write = allow

# -----------------------

mouse-reporting = false
